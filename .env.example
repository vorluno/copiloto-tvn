# Copy to .env (ignored by git). Never commit keys.
# LLM via OpenRouter (ADR-005): key from https://openrouter.ai/keys
LLM_API_KEY=
LLM_MODEL=google/gemini-2.5-flash
LLM_BASE_URL=https://openrouter.ai/api/v1
# USD per million tokens for cost in make eval / make demo-cache (J-04). Value as of 2026-10-07;
# confirm it on https://openrouter.ai/google/gemini-2.5-flash before the run and update if it changed.
LLM_PRICE_INPUT_PER_M=0.30
LLM_PRICE_OUTPUT_PER_M=2.50
# 1 = no internet: LLM output is served only from outputs/cache/
OFFLINE=0
