# Copy to .env (ignored by git). Never commit keys.
# LLM via OpenRouter (ADR-005): key from https://openrouter.ai/keys
LLM_API_KEY=
LLM_MODEL=google/gemini-2.5-flash
LLM_BASE_URL=https://openrouter.ai/api/v1
# USD per million tokens, from the model page on OpenRouter (for cost in make eval)
LLM_PRICE_INPUT_PER_M=
LLM_PRICE_OUTPUT_PER_M=
# 1 = no internet: LLM output is served only from outputs/cache/
OFFLINE=0
